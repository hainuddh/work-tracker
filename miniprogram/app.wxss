/* app.wxss - 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #4472C4;
}

.text-primary { color: #4472C4; }
.text-danger { color: #C00000; }
.text-success { color: #52c41a; }
.text-gray { color: #999; }
.text-bold { font-weight: bold; }

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.flex-1 { flex: 1; }
.text-right { text-align: right; }

.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }

/* 列表项 */
.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.list-item:last-child {
  border-bottom: none;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-left: 10rpx;
}

.tag-pending { background: #fff7e6; color: #fa8c16; }
.tag-confirmed { background: #e6f7ff; color: #1890ff; }
.tag-paid { background: #f6ffed; color: #52c41a; }

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #ccc;
}

.empty-state .icon { font-size: 80rpx; }
.empty-state .text { font-size: 28rpx; margin-top: 20rpx; }

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.form-input {
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

/* 统计卡片 */
.stat-card {
  text-align: center;
  padding: 30rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #4472C4;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-amount { color: #C00000; }
