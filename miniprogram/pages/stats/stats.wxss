/* pages/stats/stats.wxss */
.container { padding: 20rpx; }

.flex-row { display: flex; flex-direction: row; align-items: center; gap: 20rpx; }
.flex-1 { flex: 1; }
.text-right { text-align: right; }

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.form-input { background: #f9f9f9; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; min-height: 70rpx; }
.form-label { font-size: 28rpx; color: #666; margin-bottom: 8rpx; display: block; }

.calc-btn { width: 100%; margin-top: 20rpx; background-color: #4472C4; }

/* 汇总 */
.stat-summary { background: linear-gradient(135deg, #4472C4, #6BA3E0); color: #fff; }
.stat-card-row { display: flex; justify-content: space-around; text-align: center; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 36rpx; font-weight: bold; }
.stat-text { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }

/* 按老板 */
.boss-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.boss-meta { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }

.detail-item { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 24rpx; }
.detail-item:last-child { border-bottom: none; }

/* 导出 */
.export-btns { display: flex; gap: 20rpx; justify-content: center; }
.export-btn { flex: 1; }

.text-bold { font-weight: bold; }
.text-primary { color: #4472C4; }
.text-danger { color: #C00000; }

.empty-state { text-align: center; padding: 40rpx; color: #ccc; }
.empty-state .icon { font-size: 60rpx; display: block; }
.empty-state .text { font-size: 26rpx; margin-top: 10rpx; display: block; }
