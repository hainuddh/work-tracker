<!--pages/index/index.wxml - 首页-->
<view class="container">
  <!-- 未登录：微信登录按钮 -->
  <view class="card" wx:if="{{!isLoggedIn}}">
    <view class="login-hero">
      <text class="login-icon">📋</text>
      <text class="login-title">工作日志系统</text>
      <text class="login-desc">老板工作日志管理</text>
    </view>
    <button class="wechat-login-btn" bindtap="onWechatLogin">
      <text class="wechat-icon">💬</text>
      微信一键登录
    </button>
  </view>

  <!-- 已登录：仪表盘 -->
  <view wx:else>
    <!-- 欢迎信息 -->
    <view class="card" style="background: linear-gradient(135deg, #4472C4, #6BA3E0); color: #fff;">
      <view class="flex-between">
        <view>
          <text style="font-size: 36rpx; font-weight: bold;">欢迎回来 👋</text>
          <text style="font-size: 24rpx; display: block; margin-top: 8rpx; opacity: 0.9;">{{user.nickname}}</text>
        </view>
        <view bindtap="updateUserInfo" class="avatar-btn">
          <image wx:if="{{user.avatar_url}}" class="avatar-img" src="{{user.avatar_url}}" mode="aspectFill"/>
          <text wx:else class="avatar-placeholder">✏️</text>
        </view>
      </view>
    </view>

    <!-- 统计概览 -->
    <view class="card stat-card">
      <view class="flex-row" style="justify-content: space-around;">
        <view>
          <view class="stat-value">{{stats.totalBosses}}</view>
          <view class="stat-label">老板数</view>
        </view>
        <view>
          <view class="stat-value">{{stats.totalLogs}}</view>
          <view class="stat-label">日志数</view>
        </view>
        <view>
          <view class="stat-value stat-amount">¥{{stats.totalAmount}}</view>
          <view class="stat-label">总金额</view>
        </view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="card">
      <view class="card-title">快捷操作</view>
      <view class="flex-row" style="justify-content: space-around;">
        <view class="quick-btn" bindtap="goTo" url="/pages/logs/logs">
          <text class="quick-icon">📝</text>
          <text class="quick-text">记日志</text>
        </view>
        <view class="quick-btn" bindtap="goTo" url="/pages/bosses/bosses">
          <text class="quick-icon">👤</text>
          <text class="quick-text">老板</text>
        </view>
        <view class="quick-btn" bindtap="goTo" url="/pages/stats/stats">
          <text class="quick-icon">📊</text>
          <text class="quick-text">统计</text>
        </view>
        <view class="quick-btn" bindtap="onBackup">
          <text class="quick-icon">💾</text>
          <text class="quick-text">备份</text>
        </view>
      </view>
    </view>

    <!-- 最近日志 -->
    <view class="card">
      <view class="flex-between">
        <view class="card-title" style="margin-bottom: 0;">最近日志</view>
        <text class="text-primary" bindtap="goTo" url="/pages/logs/logs">查看全部 →</text>
      </view>
      <view wx:if="{{recentLogs.length > 0}}">
        <view class="list-item" wx:for="{{recentLogs}}" wx:key="id">
          <view class="flex-between">
            <view>
              <text class="text-bold">{{item.boss_name}}</text>
              <text class="text-gray" style="margin-left: 10rpx;">{{item.date}}</text>
            </view>
            <text class="text-danger text-bold">¥{{item.amount}}</text>
          </view>
          <text class="text-gray" style="font-size: 24rpx;">{{item.content}}</text>
        </view>
      </view>
      <view wx:else class="empty-state">
        <text class="icon">📭</text>
        <text class="text">暂无日志</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
