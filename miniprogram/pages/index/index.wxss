/* pages/index/index.wxss */
.container { padding: 20rpx; }

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4472C4;
}

.login-btn {
  width: 100%;
  margin-top: 20rpx;
  background-color: #4472C4;
}

.logout-btn {
  width: 100%;
  margin-top: 20rpx;
  background-color: #fff;
  color: #999;
  font-size: 26rpx;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.quick-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.quick-text { font-size: 24rpx; color: #666; }

.stat-value { font-size: 48rpx; font-weight: bold; color: #4472C4; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.stat-amount { color: #C00000; }

.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.list-item:last-child { border-bottom: none; }
