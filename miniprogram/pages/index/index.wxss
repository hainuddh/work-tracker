/* pages/index/index.wxss */
.container { padding: 20rpx; }

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4472C4;
}

/* ========== 登录页面 ========== */
.login-hero {
  text-align: center;
  padding: 60rpx 0 40rpx;
}
.login-icon {
  font-size: 100rpx;
  display: block;
}
.login-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-top: 20rpx;
}
.login-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

.wechat-login-btn {
  width: 100%;
  margin-top: 40rpx;
  background-color: #07C160;
  color: #fff;
  font-size: 32rpx;
  border: none;
  border-radius: 12rpx;
}
.wechat-login-btn::after {
  border: none;
}
.wechat-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

/* ========== 已登录页面 ========== */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.avatar-btn {
  padding: 8rpx;
}
.avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}
.avatar-placeholder {
  font-size: 28rpx;
}

.logout-btn {
  width: 100%;
  margin-top: 20rpx;
  background-color: #fff;
  color: #999;
  font-size: 26rpx;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}
.quick-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.quick-text { font-size: 24rpx; color: #666; }

.stat-value { font-size: 48rpx; font-weight: bold; color: #4472C4; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.stat-amount { color: #C00000; }

.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.list-item:last-child { border-bottom: none; }

.text-bold { font-weight: bold; }
.text-gray { color: #999; font-size: 24rpx; }
.text-primary { color: #4472C4; font-size: 24rpx; }
.text-danger { color: #C00000; }

.flex-row {
  display: flex;
  flex-direction: row;
}
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.empty-state {
  text-align: center;
  padding: 40rpx 0;
  color: #ccc;
}
.empty-state .icon { font-size: 60rpx; display: block; }
.empty-state .text { font-size: 26rpx; }
