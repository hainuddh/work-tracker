/* pages/bosses/bosses.wxss */
.container { padding: 20rpx; }

.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-1 { flex: 1; }
.flex-between { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.form-input { background: #f9f9f9; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.form-label { font-size: 28rpx; color: #666; margin-bottom: 8rpx; display: block; }

.add-btn { background-color: #4472C4; margin-left: 10rpx; }

.list-item { padding: 20rpx 0; border-bottom: 1rpx solid #eee; }
.list-item:last-child { border-bottom: none; }

/* 对话框 */
.dialog-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}

.dialog-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  width: 80%;
  max-height: 80vh;
  overflow-y: auto;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #4472C4;
}

.dialog-footer {
  display: flex;
  margin-top: 30rpx;
}

.cancel-btn {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}

.save-btn {
  flex: 1;
  background-color: #4472C4;
}

.empty-state { text-align: center; padding: 40rpx; color: #ccc; }
.empty-state .icon { font-size: 60rpx; display: block; }
.empty-state .text { font-size: 26rpx; margin-top: 10rpx; display: block; }

.text-bold { font-weight: bold; }
.text-gray { color: #999; }
.text-danger { color: #C00000; }
.mt-10 { margin-top: 10rpx; }
